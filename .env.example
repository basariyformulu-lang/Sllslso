# GEMINI_API_KEY: Required for Gemini AI API calls (optional if unused).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MySQL / MariaDB Veritabani Baglantisi
MYSQL_HOST="srv861.hstgr.io"
MYSQL_PORT="3306"
MYSQL_DATABASE="YOUR_MYSQL_DATABASE"
MYSQL_USER="YOUR_MYSQL_USER"
MYSQL_PASSWORD="YOUR_MYSQL_PASSWORD"

# Oturum Imzalama Gizli Anahtari (guclu rastgele metin)
AUTH_SECRET="CHANGE_ME_TO_A_RANDOM_64_CHAR_SECRET"

# Opsiyonel: Ilk Sistem Yoneticisi kurulum anahtari
ADMIN_BOOTSTRAP_SECRET=""
